# Thông tin Database
DB_URL=jdbc:postgresql://localhost:5432/quiz_hub
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Thông tin Google Login
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Thông tin Mail
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_email_app_password

# Thông tin JWT
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_long

# Thông tin Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Cấu hình khởi tạo cơ sở dữ liệu (Chạy lần đầu tiên đặt 'always' để nạp data.sql, các lần sau đặt 'never')
SQL_INIT_MODE=never
