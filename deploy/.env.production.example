# Production environment template for docker-compose.prod.yml.
#
# Copy this file to `.env.production` ON THE PRODUCTION SERVER ONLY
# (e.g. /opt/quizhub/.env.production). Never commit the real file.
#
#   cp deploy/.env.production.example /opt/quizhub/.env.production
#   chmod 600 /opt/quizhub/.env.production
#
# DB_URL is NOT set here: docker-compose.prod.yml builds it internally as
# jdbc:postgresql://quizhub-db:5432/quiz_hub over the Compose network, using
# the Docker service name as the host. Only the credentials below are needed.

# --- Image to deploy (set by the CD workflow to a specific ghcr.io sha-<tag>) ---
QUIZHUB_IMAGE=ghcr.io/anhtaizz/quiz-hub-v2:latest

# --- Database ---
DB_USERNAME=changeme
DB_PASSWORD=changeme

# --- Google OAuth2 login ---
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme

# --- SMTP mail ---
SPRING_MAIL_USERNAME=changeme@example.com
SPRING_MAIL_PASSWORD=changeme

# --- JWT signing secret (>= 64 characters) ---
JWT_SECRET=changeme_at_least_64_characters_long_for_security_purposes_change_this

# --- Google Gemini API ---
GEMINI_API_KEY=changeme

# --- Database seed data: 'always' loads data.sql once, then switch back to 'never' ---
SQL_INIT_MODE=never

# --- Host port the app is published on ---
APP_PORT=8080
